// Run in Logs with the workspace containing your authentication logs selected.
// Edit the identity settings below; the UPN and Windows username can differ.
// Set the portal time range to at least Lookback (or "Set in query").
// Requires Windows SecurityEvent collection and/or Entra sign-in log export.
// isfuzzy=true permits missing tables if at least one exists. Check query
// warnings: missing tables mean partial coverage, not an absence of failures.
// This does not read AD's badPasswordTime attribute or logs not collected here.
//
// Windows: 4625/4776 with 0xC000006A; 4771 with 0x18 (pre-authentication
// information invalid, commonly a wrong password). Lockout/expiry alone
// and generic Windows logon failures are deliberately excluded.
// Entra: 50126 means invalid username OR password, not proof of a bad password.
//
// WindowsDomain is optional. Set it to the recorded NetBIOS domain to avoid
// matching the same username in other domains/local accounts. A strict domain
// filter excludes events lacking a domain (often 4771/4776); inspect those
// separately and verify the reporting DC belongs to the intended domain.
// RecordingComputer is the reporting server/DC, NOT necessarily the source.
// Source IP/device details can be missing, forwarded, or reflect a proxy/VPN;
// city/country are approximate IP geolocation, not a physical user location.
let TargetUPN = "user@contoso.com";
let WindowsUsername = "user";
let WindowsDomain = "";
let Lookback = 30d;
union isfuzzy=true withsource=SourceTable
    SecurityEvent, SigninLogs, AADNonInteractiveUserSignInLogs
| where TimeGenerated >= ago(Lookback)
| extend
    EventID = toint(column_ifexists("EventID", int(null))),
    ResultType = tostring(column_ifexists("ResultType", ""))
| where
    (SourceTable == "SecurityEvent" and EventID in (4625, 4771, 4776))
    or (SourceTable != "SecurityEvent" and ResultType == "50126")
// Status/DeviceDetail/LocationDetails have different types across these tables;
// union kind=outer adds type suffixes when their schemas conflict.
| extend
    WindowsStatus = coalesce(
        tostring(column_ifexists("Status_string", "")),
        tostring(column_ifexists("Status", ""))),
    WindowsSubStatus = tostring(column_ifexists("SubStatus", "")),
    WindowsTargetAccount = tostring(column_ifexists("TargetAccount", "")),
    Device = parse_json(coalesce(
        tostring(column_ifexists("DeviceDetail_dynamic", "")),
        tostring(column_ifexists("DeviceDetail_string", "")),
        tostring(column_ifexists("DeviceDetail", "")))),
    Geo = parse_json(coalesce(
        tostring(column_ifexists("LocationDetails_dynamic", "")),
        tostring(column_ifexists("LocationDetails_string", "")),
        tostring(column_ifexists("LocationDetails", ""))))
| extend
    WindowsTargetUser = coalesce(
        tostring(column_ifexists("TargetUserName", "")),
        tostring(split(WindowsTargetAccount, "\\")[-1])),
    WindowsTargetDomain = coalesce(
        tostring(column_ifexists("TargetDomainName", "")),
        iff(WindowsTargetAccount contains "\\",
            tostring(split(WindowsTargetAccount, "\\")[0]), ""))
| where
    (SourceTable == "SecurityEvent"
        and (WindowsTargetUser =~ WindowsUsername or WindowsTargetUser =~ TargetUPN)
        and (isempty(WindowsDomain) or WindowsTargetDomain =~ WindowsDomain)
        and (
            (EventID == 4625 and (WindowsSubStatus =~ "0xC000006A" or WindowsStatus =~ "0xC000006A"))
            or (EventID == 4776 and WindowsStatus =~ "0xC000006A")
            or (EventID == 4771 and WindowsStatus in~ ("0x18", "0x00000018"))
        ))
    or (SourceTable != "SecurityEvent"
        and tostring(column_ifexists("UserPrincipalName", "")) =~ TargetUPN)
| project
    EventTimeUTC = iff(SourceTable == "SecurityEvent", TimeGenerated,
        coalesce(todatetime(column_ifexists("CreatedDateTime", datetime(null))), TimeGenerated)),
    SourceTable,
    Account = iff(SourceTable == "SecurityEvent",
        coalesce(WindowsTargetAccount, WindowsTargetUser),
        tostring(column_ifexists("UserPrincipalName", ""))),
    AccountDomain = WindowsTargetDomain,
    SourceIPAddress = iff(SourceTable == "SecurityEvent",
        coalesce(
            tostring(column_ifexists("IpAddress", "")),
            tostring(column_ifexists("ClientAddress", "")),
            tostring(column_ifexists("ClientIPAddress", ""))),
        tostring(column_ifexists("IPAddress", ""))),
    SourceWorkstation = iff(SourceTable == "SecurityEvent",
        coalesce(
            tostring(column_ifexists("WorkstationName", "")),
            tostring(column_ifexists("Workstation", ""))),
        tostring(Device.displayName)),
    RecordingComputer = tostring(column_ifexists("Computer", "")),
    Application = tostring(column_ifexists("AppDisplayName", "")),
    ClientApplication = tostring(column_ifexists("ClientAppUsed", "")),
    ProcessName = tostring(column_ifexists("ProcessName", "")),
    LogonType = tostring(column_ifexists("LogonType", "")),
    City = tostring(Geo.city),
    CountryOrRegion = tostring(Geo.countryOrRegion),
    EventID,
    FailureCode = iff(SourceTable == "SecurityEvent",
        iff(EventID == 4625 and WindowsSubStatus =~ "0xC000006A", WindowsSubStatus, WindowsStatus),
        ResultType),
    FailureDescription = case(
        SourceTable != "SecurityEvent",
            coalesce(tostring(column_ifexists("ResultDescription", "")), "Invalid username or password"),
        EventID == 4771, "Kerberos pre-authentication information invalid (commonly a wrong password)",
        "Incorrect password"),
    CorrelationId = tostring(column_ifexists("CorrelationId", ""))
// Latest observed matching event across both environments, by event time (UTC).
// Replace with "top 50 by EventTimeUTC desc" to inspect the preceding attempts.
| top 1 by EventTimeUTC desc
