// Run in Logs with the Log Analytics workspace selected as the query scope.
// Set the portal time range to "Set in query" to scan all retained data.
// Only accessible tables with records in retention appear in the results.
// Scanning every table across its retained data can be expensive. Basic/Auxiliary
// table query restrictions may require querying those tables individually instead of using union *.
// ingestion_time() is approximate UTC ingestion time, not the event timestamp.
union withsource=__LastIngestionSource *
| extend IngestionTimeUTC = ingestion_time()
| summarize LastIngestionUTC = max(IngestionTimeUTC) by __LastIngestionSource
| extend
    IngestionDateUTC = format_datetime(LastIngestionUTC, "yyyy-MM-dd"),
    IngestionTimeUTC = format_datetime(LastIngestionUTC, "HH:mm:ss.fff"),
    TimeSinceLastIngestion = now() - LastIngestionUTC
| project TableName = __LastIngestionSource, LastIngestionUTC, IngestionDateUTC, IngestionTimeUTC, TimeSinceLastIngestion
| order by LastIngestionUTC desc nulls last
