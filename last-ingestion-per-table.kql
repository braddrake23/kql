// Run in Logs with the Log Analytics workspace selected as the query scope.
// Set the portal time range to at least Lookback (or "Set in query").
// Increase Lookback to cover the tables' interactive retention for older data.
// Only accessible tables with records in this TimeGenerated window appear;
// recently ingested records with older event timestamps are excluded.
// Scanning every table can be expensive. Basic/Auxiliary table query restrictions
// may require querying those tables individually instead of using union *.
// ingestion_time() is approximate UTC ingestion time, not the event timestamp.
let Lookback = 90d;
union withsource=TableName *
| where TimeGenerated >= ago(Lookback)
| extend IngestionTimeUTC = ingestion_time()
| summarize LastIngestionUTC = max(IngestionTimeUTC) by TableName
| extend
    IngestionDateUTC = format_datetime(LastIngestionUTC, "yyyy-MM-dd"),
    IngestionTimeUTC = format_datetime(LastIngestionUTC, "HH:mm:ss.fff"),
    TimeSinceLastIngestion = now() - LastIngestionUTC
| project TableName, LastIngestionUTC, IngestionDateUTC, IngestionTimeUTC, TimeSinceLastIngestion
| order by LastIngestionUTC desc nulls last
